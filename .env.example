# --- Supabase (PostgreSQL) ---
# Ve a Project Settings -> Database en Supabase para obtener estas dos.

# Connection pooling (puerto 6543) - usada por la app en producción/runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[TU-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (puerto 5432) - usada SOLO para migraciones de Prisma
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[TU-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- NextAuth ---
# Genera un valor con: openssl rand -base64 32
NEXTAUTH_SECRET="pega-aqui-un-valor-aleatorio-largo"
NEXTAUTH_URL="http://localhost:3000"

# --- Email (SMTP) ---
# Necesario para enviar la contraseña generada automáticamente al crear usuarios.
# Puedes usar Gmail (con una "contraseña de aplicación", no tu contraseña normal),
# o cualquier proveedor SMTP (SendGrid, Resend, Mailgun, tu hosting, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu-correo@gmail.com"
SMTP_PASSWORD="tu-contraseña-de-aplicacion"
EMAIL_FROM="tu-correo@gmail.com"

# --- Supabase Storage (fotos de los centros) ---
# Project Settings -> API en tu panel de Supabase
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# --- IA del chatbot (Groq, gratis) ---
# Solo hace falta si quieres que el chatbot responda con IA cuando ninguna
# de tus respuestas "programadas" encaje con la pregunta del profesor.
# 1. Ve a https://console.groq.com y crea una cuenta (no pide tarjeta).
# 2. En "API Keys", crea una nueva y pégala aquí.
# Si dejas esto vacío, el chatbot sigue funcionando igual que antes (solo
# con las respuestas que tú programes), simplemente sin el respaldo de IA.
GROQ_API_KEY=""
