generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Conexión con pooler (puerto 6543) - usada por la app en runtime
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432) - usada solo para migraciones
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN_CENTRO
  COORDINADOR
  PROFESOR
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

enum SchoolType {
  PRIVADO
  CONCERTADO
  PUBLICO
}

enum Plan {
  BASICO
  PRO
  PREMIUM
}

enum SchoolStatus {
  ACTIVO
  REVISION
  INACTIVO
}

enum Locale {
  CA
  ES
  EN
}

model School {
  id        String       @id @default(cuid())
  name      String
  type      SchoolType   @default(PRIVADO)
  city      String?
  plan      Plan         @default(BASICO)
  status    SchoolStatus @default(ACTIVO)
  userLimit Int          @default(50)
  modules   String[]     @default([])
  logoUrl   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  users     User[]
  tutorias  Tutoria[]
  guardias  Guardia[]
  material  MaterialRequest[]
  alumnos   Alumno[]
  avisos    Aviso[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  dni          String?    @unique
  role         Role
  status       UserStatus @default(ACTIVO)
  avatarUrl    String?
  locale       Locale     @default(ES)
  lastAccessAt DateTime?
  schoolId     String?
  school       School?    @relation(fields: [schoolId], references: [id])
  createdAt    DateTime   @default(now())
  tutorias     Tutoria[]
  guardias     Guardia[]
  material     MaterialRequest[]
  horario      HorarioBloque[]
  eventos      CalendarEvento[]
  alumnos      Alumno[]
  avisos       Aviso[]
}

enum TutoriaStatus {
  PENDIENTE
  COMPLETADA
}

enum ConQuien {
  FAMILIA
  ALUMNO
  AMBOS
}

enum MedioContacto {
  TELEFONO
  EMAIL
  PRESENCIAL
  APP
}

enum RiesgoNivel {
  BAJO
  MEDIO
  ALTO
}

model Tutoria {
  id                 String        @id @default(cuid())
  schoolId           String
  school             School        @relation(fields: [schoolId], references: [id])
  profesorId         String
  profesor           User          @relation(fields: [profesorId], references: [id])
  alumnoId           String?
  alumno             Alumno?       @relation(fields: [alumnoId], references: [id])
  studentName        String
  cicloModulo        String?
  causa              String        @default("")
  status             TutoriaStatus @default(PENDIENTE)
  sessionDate        DateTime      @default(now())
  conQuien           ConQuien?
  medio              MedioContacto?
  notas              String?
  proximoSeguimiento DateTime?
  createdAt          DateTime      @default(now())
}

model Alumno {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id])
  profesorId String
  profesor   User             @relation(fields: [profesorId], references: [id])
  nombre     String
  curso      String
  edad       Int?
  riesgo     RiesgoNivel      @default(BAJO)
  avatarUrl  String?
  createdAt  DateTime         @default(now())
  contactos  AlumnoContacto[]
  tutorias   Tutoria[]
}

model AlumnoContacto {
  id       String  @id @default(cuid())
  alumnoId String
  alumno   Alumno  @relation(fields: [alumnoId], references: [id])
  relacion String
  telefono String?
  email    String?
}

enum GuardiaStatus {
  PROGRAMADA
  CUBIERTA
  PENDIENTE
}

model Guardia {
  id         String        @id @default(cuid())
  schoolId   String
  school     School        @relation(fields: [schoolId], references: [id])
  profesorId String
  profesor   User          @relation(fields: [profesorId], references: [id])
  turno      String
  ubicacion  String?
  fecha      DateTime
  status     GuardiaStatus @default(PROGRAMADA)
  createdAt  DateTime      @default(now())
}

enum MaterialCategoria {
  ELECTRONICA
  COMPONENTES
  HERRAMIENTAS
  OTROS
}

enum MaterialEstado {
  EN_STOCK
  BAJO_STOCK
  AGOTADO
}

model MaterialRequest {
  id            String            @id @default(cuid())
  schoolId      String
  school        School            @relation(fields: [schoolId], references: [id])
  profesorId    String
  profesor      User              @relation(fields: [profesorId], references: [id])
  nombre        String
  curso         String
  asignatura    String
  cantidad      Int               @default(1)
  precioUnidad  Float             @default(0)
  proveedor     String
  enlace        String?
  justificacion String
  categoria     MaterialCategoria @default(OTROS)
  estado        MaterialEstado    @default(EN_STOCK)
  createdAt     DateTime          @default(now())
}

// Horario semanal recurrente del profesor (Lunes=1 ... Viernes=5)
model HorarioBloque {
  id         String   @id @default(cuid())
  profesorId String
  profesor   User     @relation(fields: [profesorId], references: [id])
  diaSemana  Int
  horaInicio String
  horaFin    String
  asignatura String
  grupo      String?
  color      String   @default("#2F6FED")
  createdAt  DateTime @default(now())
}

// Eventos libres del calendario personal de cada usuario, con fecha concreta
model CalendarEvento {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String
  fecha      DateTime
  horaInicio String
  horaFin    String
  color      String   @default("#2F6FED")
  createdAt  DateTime @default(now())
}

enum AvisoCategoria {
  GENERAL
  ACADEMICO
  CONVIVENCIA
}

// Avisos del centro, visibles para todo el personal del mismo centro
model Aviso {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id])
  autorId   String
  autor     User           @relation(fields: [autorId], references: [id])
  titulo    String
  cuerpo    String
  categoria AvisoCategoria @default(GENERAL)
  createdAt DateTime       @default(now())
}
