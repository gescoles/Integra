generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Conexión con pooler (puerto 6543) - usada por la app en runtime
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432) - usada solo para migraciones
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN_CENTRO
  COORDINADOR
  PROFESOR
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

enum SchoolType {
  PRIVADO
  CONCERTADO
  PUBLICO
}

enum Plan {
  BASICO
  PRO
  PREMIUM
}

enum SchoolStatus {
  ACTIVO
  REVISION
  INACTIVO
}

model School {
  id        String       @id @default(cuid())
  name      String
  type      SchoolType   @default(PRIVADO)
  city      String?
  plan      Plan         @default(BASICO)
  status    SchoolStatus @default(ACTIVO)
  userLimit Int          @default(50)
  modules   String[]     @default([])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  users     User[]
  tutorias  Tutoria[]
  guardias  Guardia[]
  material  MaterialRequest[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  dni          String?    @unique
  role         Role
  status       UserStatus @default(ACTIVO)
  lastAccessAt DateTime?
  schoolId     String?
  school       School?    @relation(fields: [schoolId], references: [id])
  createdAt    DateTime   @default(now())
  tutorias     Tutoria[]
  guardias     Guardia[]
  material     MaterialRequest[]
}

enum TutoriaStatus {
  NUEVA
  SEGUIMIENTO
  COMPLETADA
  PENDIENTE
}

model Tutoria {
  id           String        @id @default(cuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id])
  profesorId   String
  profesor     User          @relation(fields: [profesorId], references: [id])
  studentName  String
  cicloModulo  String?
  status       TutoriaStatus @default(NUEVA)
  sessionDate  DateTime      @default(now())
  createdAt    DateTime      @default(now())
}

enum GuardiaStatus {
  PROGRAMADA
  CUBIERTA
  PENDIENTE
}

model Guardia {
  id         String        @id @default(cuid())
  schoolId   String
  school     School        @relation(fields: [schoolId], references: [id])
  profesorId String
  profesor   User          @relation(fields: [profesorId], references: [id])
  turno      String
  ubicacion  String?
  fecha      DateTime
  status     GuardiaStatus @default(PROGRAMADA)
  createdAt  DateTime      @default(now())
}

enum MaterialPriority {
  ALTA
  MEDIA
  BAJA
}

enum MaterialStatus {
  PENDIENTE
  EN_REVISION
  APROBADO
}

model MaterialRequest {
  id            String           @id @default(cuid())
  schoolId      String
  school        School           @relation(fields: [schoolId], references: [id])
  profesorId    String
  profesor      User             @relation(fields: [profesorId], references: [id])
  cicloModulo   String
  materialName  String
  cantidad      Int              @default(1)
  prioridad     MaterialPriority @default(MEDIA)
  costeEstimado Float            @default(0)
  status        MaterialStatus   @default(PENDIENTE)
  createdAt     DateTime         @default(now())
}
