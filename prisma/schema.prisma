generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Conexión con pooler (puerto 6543) - usada por la app en runtime
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432) - usada solo para migraciones
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN_CENTRO
  COORDINADOR
  PROFESOR
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

enum SchoolType {
  PRIVADO
  CONCERTADO
  PUBLICO
}

enum Plan {
  BASICO
  PRO
  PREMIUM
}

enum SchoolStatus {
  ACTIVO
  REVISION
  INACTIVO
}

model School {
  id        String       @id @default(cuid())
  name      String
  type      SchoolType   @default(PRIVADO)
  city      String?
  plan      Plan         @default(BASICO)
  status    SchoolStatus @default(ACTIVO)
  userLimit Int          @default(50)
  modules   String[]     @default([])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  users     User[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  dni          String?    @unique
  role         Role
  status       UserStatus @default(ACTIVO)
  lastAccessAt DateTime?
  schoolId     String?
  school       School?    @relation(fields: [schoolId], references: [id])
  createdAt    DateTime   @default(now())
}
