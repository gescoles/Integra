generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Conexión con pooler (puerto 6543) - usada por la app en runtime
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432) - usada solo para migraciones
  directUrl = env("DIRECT_URL")
}

enum EstadoPresencia {
  DISPONIBLE
  AUSENTE
  DESCONECTADO
}

enum Role {
  SUPERADMIN
  ADMIN_CENTRO
  COORDINADOR
  // Mismos permisos que Coordinador/Admin. de Centro en todo lo demás,
  // pero es quien gestiona de verdad la compra del material (Material).
  ADMINISTRACION
  PROFESOR
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

enum SchoolType {
  PRIVADO
  CONCERTADO
  PUBLICO
}

enum Plan {
  BASICO
  PRO
  PREMIUM
}

enum SchoolStatus {
  ACTIVO
  REVISION
  INACTIVO
}

enum Locale {
  CA
  ES
  EN
}

model School {
  id        String       @id @default(cuid())
  name      String
  type      SchoolType   @default(PRIVADO)
  city      String?
  plan      Plan         @default(BASICO)
  status    SchoolStatus @default(ACTIVO)
  userLimit Int          @default(50)
  modules   String[]     @default([])
  logoUrl   String?
  cursoAcademico String?
  // Lista de cursos/grupos del centro (ej. "DAM1", "1r Batxillerat A"),
  // para que los desplegables de "Curso/Grupo" (alumnos, horario...)
  // ofrezcan los grupos reales del centro en vez de texto libre.
  grupos    String[]     @default([])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  users     User[]
  alumnos   Alumno[]
  tutorias  Tutoria[]
  guardias  Guardia[]
  material  MaterialRequest[]
  chatMensajes ChatMensaje[]
  empresas  Empresa[]
  certificaciones Certificacion[]
  certificacionesCatalogo CertificacionCatalogo[]
  avisos    Aviso[]
  noticias  Noticia[]
  salidas   Salida[]
  practicas PracticaAlumno[]
  historias Historia[]
  incidencias Incidencia[]
  expedientes Expediente[]
  onboardingCarpetas OnboardingCarpeta[]
  plantas EspacioPlanta[]
  coberturas CoberturaGuardia[]
  departamentos Departamento[]
  modulosProfesionales ModuloProfesional[]
}

// Departamento del centro (p. ej. "Matemàtiques", "Informàtica"). Cada
// profesor puede pertenecer a varios, y cada departamento puede tener
// varios coordinadores. Así, al elegir los departamentos de un profesor,
// se sabe automáticamente quiénes son sus coordinadores.
model Departamento {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  nombre        String
  // Qué ciclos/cursos formativos pertenecen a este departamento — para
  // que al elegir un departamento al crear un convenio, solo salgan sus
  // ciclos, no todos los del centro mezclados.
  ciclosVinculados String[] @default([])
  profesores    User[]   @relation("DepartamentoProfesores")
  coordinadores User[]   @relation("DepartamentoCoordinadores")
  convenios     Convenio[]
  salidas       Salida[]
  certificacionesCatalogo CertificacionCatalogo[]
  empresas      Empresa[]
  createdAt     DateTime @default(now())
}

// Una "historia" (como en Instagram) que un centro publica; la ven todos
// los usuarios de todos los centros registrados en Docentium, y desaparece
// pasadas 24 horas.
enum TipoHistoria {
  IMAGEN
  VIDEO
}

enum PrioridadIncidencia {
  BAJA
  MEDIA
  ALTA
}

enum EstadoIncidencia {
  ABIERTA
  EN_SEGUIMIENTO
  CERRADA
}

// Un expediente/incidencia disciplinaria de un alumno. Lo puede crear
// cualquier profesor (queda como creador), eligiendo quién es el tutor
// responsable de darle seguimiento; a ese tutor le llega un email y una
// notificación en la app al crearse.
model Incidencia {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  alumnoId String
  alumno   Alumno @relation(fields: [alumnoId], references: [id])

  creadorId String
  creador   User   @relation("IncidenciaCreador", fields: [creadorId], references: [id])
  tutorId   String
  tutor     User   @relation("IncidenciaTutor", fields: [tutorId], references: [id])

  tipoIncidencia String
  prioridad      PrioridadIncidencia @default(MEDIA)
  estado         EstadoIncidencia    @default(ABIERTA)

  fecha   DateTime
  lugar   String?

  descripcion      String
  observaciones    String?
  medidasAplicadas String?

  familiaInformada            Boolean   @default(false)
  familiaInformadaFecha       DateTime?
  familiaInformadaComunicacion String?

  eventos     IncidenciaEvento[]
  expedientes Expediente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum EstadoExpediente {
  BORRADOR
  ENVIADO
}

// El "parte y expulsión" formal. Un alumno (o una misma incidencia, si se
// repite) puede tener VARIOS expedientes a lo largo del tiempo, cada uno
// con su propio número. Se crea como borrador, se puede editar mientras
// esté en borrador, y Coordinación/Dirección/SuperAdmin lo envía al tutor
// cuando está listo (por email, con el PDF adjunto, + notificación).
// Carpetas de OnBoarding para nuevas incorporaciones. Solo Coordinación,
// Dirección o SuperAdmin pueden crearlas, subir archivos o borrar.
model OnboardingCarpeta {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  nombre      String
  creadoPorId String?
  creadoPor   User?    @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)
  archivos    OnboardingArchivo[]
  createdAt   DateTime @default(now())
}

model OnboardingArchivo {
  id          String            @id @default(cuid())
  carpetaId   String
  carpeta     OnboardingCarpeta @relation(fields: [carpetaId], references: [id], onDelete: Cascade)
  nombre      String
  url         String
  tipo        String?
  tamano      Int?
  subidoPorId String?
  subidoPor   User?             @relation(fields: [subidoPorId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
}

// Reserva de espacios: cada centro tiene sus plantas, cada planta sus
// aulas (con su posición y tamaño para dibujarlas en 3D), y cada aula sus
// reservas horarias.
model EspacioPlanta {
  id        String        @id @default(cuid())
  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id])
  numero    Int
  nombre    String
  aulas     EspacioAula[]
  createdAt DateTime      @default(now())

  @@unique([schoolId, numero])
}

model EspacioAula {
  id         String            @id @default(cuid())
  plantaId   String
  planta     EspacioPlanta     @relation(fields: [plantaId], references: [id], onDelete: Cascade)
  nombre     String
  // Posición y tamaño en la cuadrícula del plano (unidades arbitrarias,
  // coherentes con el boceto en cuadrícula), usadas para pintar la caja
  // en 3D y para saber dónde colocarla.
  x          Float
  z          Float
  ancho      Float
  profundo   Float
  alto       Float             @default(2.5)
  color      String            @default("#94A3B8")
  bloqueada       Boolean       @default(false)
  motivoBloqueo   String?
  reservas   EspacioReserva[]
  createdAt  DateTime          @default(now())
}

model EspacioReserva {
  id          String      @id @default(cuid())
  aulaId      String
  aula        EspacioAula @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation("EspacioReservaUsuario", fields: [userId], references: [id])
  creadoPorId String
  creadoPor   User        @relation("EspacioReservaCreador", fields: [creadoPorId], references: [id])
  fecha       DateTime
  horaInicio  String
  horaFin     String
  createdAt   DateTime    @default(now())
}

model Expediente {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])
  alumnoId     String
  alumno       Alumno     @relation(fields: [alumnoId], references: [id])
  incidenciaId String
  incidencia   Incidencia @relation(fields: [incidenciaId], references: [id])

  tutorId     String
  tutor       User @relation("ExpedienteTutor", fields: [tutorId], references: [id])
  creadoPorId String
  creadoPor   User @relation("ExpedienteCreador", fields: [creadoPorId], references: [id])

  numero String
  estado EstadoExpediente @default(BORRADOR)

  fechaInicio           DateTime
  fets                  String
  testimonis            String
  informeTutor          String
  audienciaResumen      String
  valoracionComision    String
  medidasProvisionales  String
  sancionDias           Int
  sancionMotivo         String
  fechaAplicacionInicio DateTime
  fechaAplicacionFin    DateTime
  recursoEstado         String
  direccionNombre       String
  coordinadorNombre     String

  enviadoEn DateTime?

  // Firmas capturadas antes de enviar (imagen en base64), y el email
  // adicional (del alumno) al que también se manda copia.
  firmaDireccion   String?
  firmaTutor       String?
  firmaCoordinador String?
  firmaAlumno      String?
  emailAlumno      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// El historial de actualizaciones que se ve en el detalle de la incidencia:
// se genera solo (creación, cambios de estado, familia informada...), sin
// que nadie tenga que escribirlo a mano.
model IncidenciaEvento {
  id           String     @id @default(cuid())
  incidenciaId String
  incidencia   Incidencia @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)
  tipo         String
  descripcion  String
  autorId      String?
  autor        User?      @relation(fields: [autorId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
}

model Historia {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id])
  autorId      String
  autor        User         @relation(fields: [autorId], references: [id])
  tipo         TipoHistoria @default(IMAGEN)
  imagenUrl    String
  texto        String?
  ciclo        String?
  createdAt    DateTime     @default(now())
  expiraEn     DateTime
  vistas       HistoriaVista[]
}

// Registro de quién ha visto cada historia (para el "quién ha visto mi
// historia").
model HistoriaVista {
  id         String   @id @default(cuid())
  historiaId String
  historia   Historia @relation(fields: [historiaId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  vistoEn    DateTime @default(now())

  @@unique([historiaId, userId])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  dni          String?    @unique
  role         Role
  status       UserStatus @default(ACTIVO)
  avatarUrl    String?
  locale       Locale     @default(ES)
  lastAccessAt DateTime?
  schoolId     String?
  school       School?    @relation(fields: [schoolId], references: [id])
  createdAt    DateTime   @default(now())
  tutorias     Tutoria[]
  guardias     Guardia[]
  material     MaterialRequest[]
  materialValidado MaterialRequest[] @relation("MaterialValidadoPor")
  materialComprado MaterialRequest[] @relation("MaterialCompradoPor")
  empresasCreadas Empresa[]
  historialPropio UserHistorial[]
  certificacionesCreadas Certificacion[]
  registrosAcceso RegistroAcceso[]
  // Chat interno entre usuarios del centro (no confundir con el asistente
  // de IA, que es aparte). El estado se pone a mano desde el propio chat;
  // no se calcula solo a partir de la sesión.
  estadoPresencia   EstadoPresencia @default(DESCONECTADO)
  mensajesEnviados  ChatMensaje[]   @relation("ChatEmisor")
  mensajesRecibidos ChatMensaje[]   @relation("ChatReceptor")
  horario      HorarioBloque[]
  eventos      CalendarEvento[]
  alumnos      Alumno[]
  avisos       Aviso[]
  noticias     Noticia[]
  salidasCreadas     Salida[] @relation("SalidaCreador")
  salidasResponsable Salida[] @relation("SalidaResponsable")
  salidasAnuladas    Salida[] @relation("SalidaAnuladaPor")
  practicasComoTutor PracticaAlumno[] @relation("PracticaTutorIMES")
  practicasComoResponsable PracticaAlumno[] @relation("PracticaResponsable")
  conveniosCerrados  Convenio[] @relation("ConvenioCerradoPor")
  tutoriasSeguimientoCreadas TutoriaSeguimiento[] @relation("TutoriaSeguimientoCreador")
  historias         Historia[]
  historiasVistas   HistoriaVista[]
  incidenciasCreadas     Incidencia[] @relation("IncidenciaCreador")
  incidenciasComoTutor   Incidencia[] @relation("IncidenciaTutor")
  incidenciaEventos      IncidenciaEvento[]
  expedientesComoTutor   Expediente[] @relation("ExpedienteTutor")
  expedientesCreados     Expediente[] @relation("ExpedienteCreador")
  onboardingCarpetasCreadas OnboardingCarpeta[]
  onboardingArchivosSubidos OnboardingArchivo[]
  espacioReservas        EspacioReserva[] @relation("EspacioReservaUsuario")
  espacioReservasCreadas EspacioReserva[] @relation("EspacioReservaCreador")
  coberturasComoAusente     CoberturaGuardia[] @relation("CoberturaAusente")
  coberturasComoSustituto   CoberturaGuardia[] @relation("CoberturaSustituto")
  coberturasCreadas         CoberturaGuardia[] @relation("CoberturaCreador")
  // Un profesor puede pertenecer a varios departamentos, y un coordinador
  // puede coordinar varios departamentos (con varios profesores cada uno).
  departamentos             Departamento[]     @relation("DepartamentoProfesores")
  departamentosCoordinados  Departamento[]     @relation("DepartamentoCoordinadores")
  notificaciones     Notificacion[]
}

enum TutoriaStatus {
  PENDIENTE
  COMPLETADA
}

enum ConQuien {
  FAMILIA
  ALUMNO
  AMBOS
}

enum MedioContacto {
  TELEFONO
  EMAIL
  PRESENCIAL
  APP
}

enum RiesgoNivel {
  BAJO
  MEDIO
  ALTO
}

model Tutoria {
  id                 String        @id @default(cuid())
  schoolId           String
  school             School        @relation(fields: [schoolId], references: [id])
  profesorId         String
  profesor           User          @relation(fields: [profesorId], references: [id])
  alumnoId           String?
  alumno             Alumno?       @relation(fields: [alumnoId], references: [id])
  studentName        String
  cicloModulo        String?
  causa              String        @default("")
  status             TutoriaStatus @default(PENDIENTE)
  sessionDate        DateTime      @default(now())
  conQuien           ConQuien?
  medio              MedioContacto?
  notas              String?
  proximoSeguimiento DateTime?
  createdAt          DateTime      @default(now())
}

model Alumno {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id])
  profesorId String
  profesor   User             @relation(fields: [profesorId], references: [id])
  nombre     String
  curso      String
  edad       Int?
  riesgo     RiesgoNivel      @default(BAJO)
  avatarUrl  String?
  // Datos identificativos del alumno. Se piden al crear el alumno desde
  // Tutorías, y luego se muestran bloqueados (solo lectura) en la ficha de
  // Prácticas — para editarlos hay que hacerlo desde la ficha del alumno.
  fechaNacimiento DateTime?
  tipoDocumento   TipoDocumento?
  numeroDocumento String?
  direccion       String?
  createdAt  DateTime         @default(now())
  contactos  AlumnoContacto[]
  tutorias   Tutoria[]
  practicas  PracticaAlumno[]
  incidencias Incidencia[]
  expedientes Expediente[]
}

enum TipoDocumento {
  DNI
  NIE
  PASAPORTE
}

model AlumnoContacto {
  id       String  @id @default(cuid())
  alumnoId String
  alumno   Alumno  @relation(fields: [alumnoId], references: [id])
  relacion String
  telefono String?
  email    String?
}

// Nota: PROGRAMADA se mantiene en la base de datos por compatibilidad con
// filas antiguas (para no romper el enum en Postgres), pero la app ya no
// la usa: el vocabulario real ahora es Pendiente / Cubierta / Rechazada.
enum GuardiaStatus {
  PROGRAMADA
  CUBIERTA
  PENDIENTE
  RECHAZADA
}

model ChatbotEntry {
  id           String   @id @default(cuid())
  pregunta     String
  palabrasClave String[] @default([])
  respuesta    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model ChatbotPreguntaSinResponder {
  id        String   @id @default(cuid())
  texto     String
  vista     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Notificacion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?
  tipo      String
  titulo    String
  mensaje   String
  link      String?
  relatedId String?
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, leida])
  @@index([relatedId])
}

enum SalidaEstado {
  PENDIENTE
  APROBADA
  RECHAZADA
  ANULADA
}

model Salida {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id])
  curso        String
  tipo         String?
  actividad    String
  fecha        DateTime
  horaSalida   String
  horaVuelta   String?
  responsableId String
  responsable   User        @relation("SalidaResponsable", fields: [responsableId], references: [id])
  profesoresIds String[]    @default([])
  numAlumnos   Int
  costo        Float        @default(0)
  moneda       String       @default("EUR")
  observaciones String?
  calendarioSustituciones String?
  estado       SalidaEstado @default(PENDIENTE)
  // Anulación: solo Admin. de Centro/SuperAdmin puede anular una salida ya
  // aprobada, siempre con un motivo obligatorio. Se avisa por email al
  // profesor que la creó.
  motivoAnulacion String?
  anuladaPorId    String?
  anuladaPor      User?    @relation("SalidaAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: SetNull)
  fechaAnulacion  DateTime?
  // Departamento al que pertenece la salida: al aprobarla, se avisa a
  // todos los profesores y coordinadores de ese departamento.
  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  creadoPorId  String
  creadoPor    User         @relation("SalidaCreador", fields: [creadoPorId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
}

enum Promocion {
  PRIMERA
  SEGUNDA
}

// Ficha de un alumno en prácticas: sus datos personales/administrativos.
// Cada alumno tiene UNA ficha, y a partir de ahí se le pueden crear uno o
// varios convenios (a lo largo del tiempo, o si repite ciclo, etc.).
model PracticaAlumno {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  alumnoId String @unique
  alumno   Alumno @relation(fields: [alumnoId], references: [id])

  promocion      Promocion @default(PRIMERA)
  cicloFormativo String?
  anyTitulacion  String?

  // Tutor iMES = el tutor/a académico REAL del alumno (el mismo que en
  // Tutorías/Mis Alumnos), nunca quien crea la ficha. Se rellena solo, a
  // partir del alumno elegido, y no se puede tocar desde aquí.
  tutorImesId String?
  tutorImes   User?   @relation("PracticaTutorIMES", fields: [tutorImesId], references: [id], onDelete: SetNull)

  // Responsable de prácticas = quien de verdad lleva el seguimiento de
  // este alumno en Prácticas (normalmente quien crea la ficha, pero puede
  // no ser su tutor/a real — p. ej. el coordinador de FCT). Equipo
  // directivo puede cambiarlo más adelante si hace falta reasignarlo.
  responsablePracticasId String?
  responsablePracticas   User?   @relation("PracticaResponsable", fields: [responsablePracticasId], references: [id], onDelete: SetNull)

  dni             String?
  fechaNacimiento DateTime?
  telefono        String?
  direccion       String?
  correoAlumno    String?
  cap             String?
  nuss            String?

  convenios Convenio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Un alumno puede tener varios convenios (por ejemplo, si cambia de empresa,
// o repite curso). Cada convenio es un acuerdo de prácticas concreto.
enum TipoTutoriaSeguimiento {
  INICIAL
  MEDIA
  FINAL
}

model Convenio {
  id               String         @id @default(cuid())
  practicaAlumnoId String
  practicaAlumno   PracticaAlumno @relation(fields: [practicaAlumnoId], references: [id], onDelete: Cascade)

  // Vínculo opcional con el módulo Empresas: si el convenio se creó
  // eligiendo una empresa de la base de datos (en vez de escribiéndola a
  // mano), queda enlazada aquí. Nada de lo que ya existía se toca — los
  // campos de texto de la empresa siguen ahí igual, solo que ahora se
  // pueden rellenar solos al elegir la empresa.
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  tipologia       String?
  estadoAcuerdo   String?
  // Horas convalidadas de las prácticas: 0 si no convalida ninguna, o el
  // número de horas que sí se convalidan. Sustituye al antiguo checkbox
  // "convalida" (sí/no), que no permitía indicar cuánto.
  horasConvalidadas Int @default(0)
  // Año del ciclo en el que el alumno hace estas prácticas concretas
  // (un mismo ciclo tiene 2 años, y las prácticas se pueden hacer en
  // cualquiera de los dos según el centro).
  anyCurso String?
  quienAltaBajaSS String?
  fechaInicio     DateTime?
  fechaFin        DateTime?
  periodo         String?

  empresaCif           String?
  empresaNombre        String?
  tutorEmpresaNombre   String?
  tutorEmpresaTelefono String?
  tutorEmpresaCorreo   String?

  observaciones String?

  // Cierre del convenio: lo puede cerrar el profesor tutor (si ya están las
  // 3 tutorías de seguimiento) o, sin esa condición y siempre editable
  // después, Coordinación/Dirección/SuperAdmin.
  cerrado      Boolean   @default(false)
  notaFinal    String?
  fechaCierre  DateTime?
  cerradoPorId String?
  cerradoPor   User?     @relation("ConvenioCerradoPor", fields: [cerradoPorId], references: [id], onDelete: SetNull)

  // Departamento al que pertenece este convenio (p. ej. Informàtica). Se usa
  // para filtrar el catálogo de módulos profesionales del ciclo elegido, y
  // para saber a qué profesores enviar las notas.
  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  // Grupo/ciclo del alumno para el que se eligieron los módulos (p. ej.
  // "DAM1"). Se guarda tal cual, independientemente del curso real del
  // alumno, porque un convenio se puede reutilizar de un curso a otro.
  cicloGrupo     String?
  modulos        ConvenioModulo[]

  prorrogas           Prorroga[]
  tutoriasSeguimiento TutoriaSeguimiento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Catálogo de módulos profesionales por ciclo formativo (DAM, ASIX, SIMIX...)
// con las horas oficiales a realizar en el centro y en la empresa. Es un
// catálogo de centro, no depende de ningún alumno ni convenio concreto.
model ModuloProfesional {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  cicloFormativo String   // "DAM" | "ASIX" | "SIMIX" (prefijo del grupo, sin el número)
  codigo         String   // "0485"
  nombre         String   // "Programació."
  horasCentro    Int
  horasEmpresa   Int
  orden          Int      @default(0)
  convenios      ConvenioModulo[]

  @@unique([schoolId, cicloFormativo, codigo])
}

// Módulo profesional concreto elegido dentro de un convenio, con las horas
// de empresa (editable: parte del total oficial, o el total si se hace
// completo) y la nota una vez evaluado.
model ConvenioModulo {
  id                  String            @id @default(cuid())
  convenioId          String
  convenio            Convenio          @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  moduloProfesionalId String
  moduloProfesional   ModuloProfesional @relation(fields: [moduloProfesionalId], references: [id])
  horasEmpresa         Int              // autocompletado desde el catálogo al elegirlo, pero editable
  nota                 String?
  notaEnviada          Boolean          @default(false)
  createdAt            DateTime         @default(now())

  @@unique([convenioId, moduloProfesionalId])
}

// Las 3 tutorías de seguimiento de un convenio en prácticas: inicial, media
// y final. Hay que registrarlas antes de que un profesor pueda cerrar el
// convenio (Coordinación/SuperAdmin pueden saltárselo).
model TutoriaSeguimiento {
  id          String                 @id @default(cuid())
  convenioId  String
  convenio    Convenio               @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  tipo        TipoTutoriaSeguimiento
  fecha       DateTime?
  resumen     String?
  medioContacto String?
  creadoPorId String?
  creadoPor   User?                  @relation("TutoriaSeguimientoCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @default(now()) @updatedAt

  @@unique([convenioId, tipo])
}

// Una prórroga alarga (o repite) el período de un convenio ya existente.
// Tiene los mismos campos que un convenio (puede cambiar de empresa,
// tipología, etc.), y un convenio puede tener varias prórrogas seguidas.
model Prorroga {
  id         String   @id @default(cuid())
  convenioId String
  convenio   Convenio @relation(fields: [convenioId], references: [id], onDelete: Cascade)

  tipologia       String?
  estadoAcuerdo   String?
  convalida       Boolean   @default(false)
  quienAltaBajaSS String?
  fechaInicio     DateTime?
  fechaFin        DateTime?
  periodo         String?

  empresaCif           String?
  empresaNombre        String?
  tutorEmpresaNombre   String?
  tutorEmpresaTelefono String?
  tutorEmpresaCorreo   String?

  observaciones String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Guardia {
  id         String        @id @default(cuid())
  schoolId   String
  school     School        @relation(fields: [schoolId], references: [id])
  profesorId String
  profesor   User          @relation(fields: [profesorId], references: [id])
  turno      String?
  ubicacion  String?
  grupo      String?
  tarea      String?
  fecha      DateTime
  status     GuardiaStatus @default(PENDIENTE)
  createdAt  DateTime      @default(now())
}

enum MaterialCategoria {
  ELECTRONICA
  COMPONENTES
  HERRAMIENTAS
  OTROS
}

enum MaterialEstado {
  PENDIENTE_VALIDACION
  VALIDADO_PENDIENTE_COMPRA
  COMPRADO
}

model MaterialRequest {
  id            String            @id @default(cuid())
  schoolId      String
  school        School            @relation(fields: [schoolId], references: [id])
  profesorId    String
  profesor      User              @relation(fields: [profesorId], references: [id])
  nombre        String
  curso         String
  asignatura    String
  cantidad      Int               @default(1)
  precioUnidad  Float             @default(0)
  proveedor     String
  enlace        String?
  justificacion String
  categoria     MaterialCategoria @default(OTROS)
  estado        MaterialEstado    @default(PENDIENTE_VALIDACION)
  // Quién lo valida (Administración/equipo directivo) y cuándo — a partir
  // de aquí el profesor pasa a ver "Validado / pendiente de compra".
  validadoPorId String?
  validadoPor   User?             @relation("MaterialValidadoPor", fields: [validadoPorId], references: [id], onDelete: SetNull)
  validadoEn    DateTime?
  // Quién marca que ya se ha comprado y cuándo — a partir de aquí se
  // avisa al profesor de que puede pasar a recogerlo por secretaría.
  compradoPorId String?
  compradoPor   User?             @relation("MaterialCompradoPor", fields: [compradoPorId], references: [id], onDelete: SetNull)
  compradoEn    DateTime?
  createdAt     DateTime          @default(now())
}

// Horario semanal recurrente del profesor (Lunes=1 ... Viernes=5)
model HorarioBloque {
  id         String   @id @default(cuid())
  profesorId String
  profesor   User     @relation(fields: [profesorId], references: [id])
  diaSemana  Int
  horaInicio String
  horaFin    String
  asignatura String
  grupo      String?
  aula       String?
  color      String   @default("#2F6FED")
  // Si está marcado, esta franja no es una clase: es una hora de guardia
  // del profesor, y se usa para saber quién está disponible al buscar
  // quién puede cubrir una ausencia.
  esGuardia  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Eventos libres del calendario personal de cada usuario, con fecha concreta

// Cuando un profesor falta, Coordinación/Dirección/SuperAdmin buscan quién
// está de guardia en esa franja concreta y le piden que cubra la clase.
// Queda constancia de quién cubrió a quién y cuándo.
enum EstadoCobertura {
  PENDIENTE
  ACEPTADA
  ASIGNADA
  RECHAZADA
}

enum EstadoJustificante {
  PENDIENTE
  RECIBIDO
  NO_ENTREGADO
  NO_APLICA
}

model CoberturaGuardia {
  id                  String          @id @default(cuid())
  schoolId            String
  school              School          @relation(fields: [schoolId], references: [id])
  profesorAusenteId   String
  profesorAusente     User            @relation("CoberturaAusente", fields: [profesorAusenteId], references: [id])
  profesorSustitutoId String?
  profesorSustituto   User?           @relation("CoberturaSustituto", fields: [profesorSustitutoId], references: [id])
  fecha               DateTime
  horaInicio          String
  horaFin             String
  asignatura          String?
  grupo               String?
  ubicacion           String?
  // Lo que el profesor ausente ha dejado explicado para sus alumnos: qué
  // deben hacer mientras no está. Solo se rellena cuando es el propio
  // profesor quien avisa (no cuando dirección crea la guardia a mano).
  trabajoAlumnos      String?
  // Motivo de la ausencia, cuando es el profesor quien avisa.
  motivo              String?
  // Motivo que da dirección al rechazar una solicitud, para que el
  // profesor sepa por qué sin tener que preguntar por otro lado.
  motivoRechazo       String?
  estado              EstadoCobertura @default(ASIGNADA)
  // El justificante médico/oficial de la ausencia — se marca a mano desde
  // el panel de dirección, independientemente de si ya se ha aceptado o
  // asignado sustituto.
  estadoJustificante  EstadoJustificante @default(PENDIENTE)
  justificanteUrl     String?
  justificanteNombre  String?
  justificanteFecha   DateTime?
  creadoPorId         String
  creadoPor           User            @relation("CoberturaCreador", fields: [creadoPorId], references: [id])
  createdAt           DateTime        @default(now())
}

model CalendarEvento {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String
  fecha      DateTime
  horaInicio String
  horaFin    String
  color      String   @default("#2F6FED")
  createdAt  DateTime @default(now())
}

enum AvisoCategoria {
  GENERAL
  ACADEMICO
  CONVIVENCIA
}

// Avisos del centro, visibles para todo el personal del mismo centro
model Aviso {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id])
  autorId   String
  autor     User           @relation(fields: [autorId], references: [id])
  titulo    String
  cuerpo    String
  categoria AvisoCategoria @default(GENERAL)
  createdAt DateTime       @default(now())
}

enum NoticiaModo {
  SIMPLE // texto escrito desde el propio formulario
  PERSONALIZADO // HTML + CSS subidos por el SuperAdmin
}

enum NoticiaCategoria {
  CENTRO // noticia/publicidad de un centro concreto
  EDUCACION_ESPANA // noticia general de educación en España, sin centro asociado
}

// Noticias/publicidad que el SuperAdmin publica en la web pública de
// Docentium (/noticias). Dos categorías: EDUCACION_ESPANA (contenido
// curado por Docentium sobre actualidad educativa, sin centro asociado,
// siempre con fuente citada) y CENTRO (asociada a un centro concreto,
// sirve como escaparate/marketing — para eso está Aviso, no esto, ya que
// Aviso es interno para el propio centro).
model Noticia {
  id               String           @id @default(cuid())
  schoolId         String?
  school           School?          @relation(fields: [schoolId], references: [id])
  autorId          String?
  autor            User?            @relation(fields: [autorId], references: [id], onDelete: SetNull)
  slug             String           @unique
  titulo           String
  resumen          String
  imagenPortada    String?
  categoria        NoticiaCategoria @default(CENTRO)
  modo             NoticiaModo      @default(SIMPLE)
  cuerpoHtml       String           @db.Text
  cssPersonalizado String?          @db.Text
  fuenteNombre     String?
  fuenteUrl        String?
  publicada        Boolean          @default(false)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
}

// Chat interno entre usuarios del mismo centro (distinto del asistente de
// IA). Conversaciones 1 a 1, sin agrupar en un modelo de "conversación"
// aparte — se calculan al vuelo a partir de emisor+receptor.
model ChatMensaje {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  // Opcionales a propósito: si se borra el usuario, el mensaje se queda
  // (no desaparece la conversación), pero pierde el vínculo — la
  // interfaz muestra "Usuario no encontrado" en su lugar.
  emisorId   String?
  emisor     User?    @relation("ChatEmisor", fields: [emisorId], references: [id], onDelete: SetNull)
  receptorId String?
  receptor   User?    @relation("ChatReceptor", fields: [receptorId], references: [id], onDelete: SetNull)
  texto      String
  leido      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([emisorId, receptorId])
  @@index([receptorId, leido])
}

// ── Módulo Empresas (independiente del de Prácticas/Convenios, a
// propósito — no se toca nada de ese módulo). El "convenio" de cada
// empresa vive aquí dentro, así que al borrar la empresa desaparece con
// ella sin tocar ningún otro modelo.
enum EmpresaEstado {
  ACTIVO
  INACTIVO
}

model Empresa {
  id                String    @id @default(cuid())
  schoolId          String
  school            School    @relation(fields: [schoolId], references: [id])

  razonSocial       String
  nombreComercial   String
  cif               String?
  // "Sector" ahora es en realidad el departamento del centro al que
  // pertenece la empresa (antes era texto libre) — se mantiene el nombre
  // de columna por compatibilidad, pero guarda el nombre del departamento.
  sector            String?
  departamentoId    String?
  departamento      Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  sitioWeb          String?
  correoCorporativo String?

  // Para la ficha de empresa: descripción general y datos rápidos de la
  // propia empresa (no del convenio, ni de contacto).
  descripcion       String?
  anyoFundacion     Int?
  numEmpleados      Int?
  tamanoEmpresa     String?
  tipoEmpresa       String?

  contactoNombre    String?
  contactoCargo     String?
  contactoEmail     String?
  // Correos de contacto extra, si con uno no basta — el principal sigue
  // siendo contactoEmail de arriba.
  contactoEmailsExtra String[] @default([])
  telefonoDirecto   String?

  telefono          String?
  direccion         String?
  codigoPostal      String?
  ciudad            String?
  provincia         String?

  convenioVigente   Boolean   @default(false)
  convenioInicio    DateTime?
  convenioFin       DateTime?
  renovableAuto     Boolean   @default(false)
  vacantes          Int       @default(1)
  modalidad         String?
  horarioHabitual   String?

  ciclosVinculados  String[]  @default([])
  requisitos        String?
  observaciones     String?

  // Inactivo por defecto hasta que se asigne al menos un alumno — de
  // momento se marca a mano; cuando exista una relación real con alumnos
  // en prácticas, se podrá automatizar sin tocar este campo desde fuera.
  estado            EmpresaEstado @default(INACTIVO)

  creadoPorId       String?
  creadoPor         User?     @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  documentos        EmpresaDocumento[]
  historial         EmpresaHistorial[]
  notasObservaciones EmpresaObservacion[]
  convenios         Convenio[]
}

model EmpresaDocumento {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre     String
  url        String
  createdAt  DateTime @default(now())
}

// Historial de cambios de cada empresa: quién ha hecho qué y cuándo.
model EmpresaHistorial {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  accion        String
  detalle       String?
  usuarioId     String?
  usuarioNombre String
  createdAt     DateTime @default(now())
}

// Observaciones de una empresa, como un hilo de notas — cada persona
// añade la suya, sin borrar las de los demás, con su fecha y su nombre.
model EmpresaObservacion {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  texto         String
  usuarioId     String?
  usuarioNombre String
  createdAt     DateTime @default(now())
}

// Código temporal para "he olvidado mi contraseña" — se manda por correo,
// caduca a los 15 minutos, y se borra en cuanto se usa (o se pide otro).
model PasswordResetCode {
  id        String   @id @default(cuid())
  email     String
  codigo    String
  usado     Boolean  @default(false)
  expiraEn  DateTime
  createdAt DateTime @default(now())

  @@index([email, codigo])
}

// Ajustes globales de la plataforma — una única fila siempre (id fijo
// "global"). Por ahora solo el interruptor de recuperar contraseña.
model Configuracion {
  id                     String  @id @default("global")
  // El login con email+contraseña funciona siempre con normalidad para
  // quien ya tenga una (generada y enviada por un admin). Lo que controla
  // este campo es "¿Has olvidado tu contraseña?": con esto en false (lo
  // normal), solo el SuperAdmin puede usarlo — todos los demás ven la
  // opción igual, pero les sale un aviso de que está bloqueado. Se activa
  // desde el panel de SuperAdmin el día que haga falta un plan B general.
  loginPasswordHabilitado Boolean @default(false)
  // Con esto en true (por defecto, como funcionaba hasta ahora), las
  // Historias que sube cualquier centro las ven todos los centros entre
  // sí. Con esto en false, cada centro solo ve las suyas propias.
  historiasEntreCentros   Boolean @default(true)
}

// Historial de un usuario: qué le han hecho, quién y cuándo (crear,
// activar/desactivar, mandarle contraseña...). Vive aparte del propio
// usuario para que, si el usuario se borra, este registro también
// desaparezca con él (no tiene sentido guardarlo suelto).
model UserHistorial {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accion        String
  detalle       String?
  hechoPorId    String?
  hechoPorNombre String
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Módulo Certificaciones ──────────────────────────────────────────
// Las certificaciones (PUE) son las mismas para cualquier centro
// (Microsoft, Cisco, etc.), así que el catálogo de nombres lo gestiona el
// SuperAdmin UNA vez para toda la plataforma — no es propio de un centro.
enum EstadoCertificacion {
  PROXIMAMENTE
  PROGRAMADA
  EN_CURSO
  ACTIVA
  ACABADA
}

model CertificacionCatalogo {
  id           String   @id @default(cuid())
  categoria    String
  // Si se deja sin centro, el curso vale para todos los centros de la
  // plataforma (como hasta ahora). Si se le pone un centro concreto,
  // solo ese centro lo verá — y entonces sí puede llevar un departamento
  // real de ESE centro (los departamentos son siempre de un centro).
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  departamentoId String?
  departamentoRef Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  nombre       String
  horasDefault Int?
  sedeExamenDefault String?

  // El "curso" completo, para que cualquier rol pueda consultar de qué va
  // antes de programar una certificación real a partir de él.
  acercaDe               String?
  dirigidoA              String?
  objetivos              String?
  certificacionInfo      String?
  contenidos             String?
  proximasConvocatorias  String?

  createdAt    DateTime @default(now())
}

model Certificacion {
  id                     String              @id @default(cuid())
  schoolId               String
  school                 School              @relation(fields: [schoolId], references: [id])

  categoria              String
  nombreCertificacion    String
  cursoAcademico         String
  cicloFormativo         String
  horas                  Int?

  fechaInicioPreparacion DateTime
  fechaFinPreparacion    DateTime?
  fechaExamen            DateTime?
  estado                 EstadoCertificacion @default(PROGRAMADA)

  codigoPue              String?
  entidadCertificadora   String?
  nivelMCE               String?
  duracionExamen         String?
  modalidad              String?
  sedeExamen             String?
  notas                  String?

  creadoPorId            String?
  creadoPor              User?               @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @default(now()) @updatedAt
}

// Registro de intentos de login fallidos, para poder bloquear
// temporalmente tras varios intentos seguidos (protección contra fuerza
// bruta). Se limpia solo con el tiempo, no hace falta borrarlo a mano.
model IntentoLoginFallido {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// Registro de cada inicio de sesión CORRECTO (quién y cuándo), a
// diferencia de IntentoLoginFallido que solo guarda los fallidos. No se
// borra nunca automáticamente — es el historial de accesos real.
model RegistroAcceso {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  nombre    String
  metodo    String   // "password" | "microsoft"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Un bloqueo de acceso real (5 intentos fallidos en 15 minutos) — a
// diferencia de IntentoLoginFallido, esto NO se borra nunca. Queda
// PENDIENTE hasta que el SuperAdmin hace algo al respecto (desbloquear,
// regenerar contraseña, reenviar invitación...), momento en que pasa a
// RESUELTO, con quién lo resolvió, cuándo, y cómo.
enum EstadoBloqueo {
  PENDIENTE
  RESUELTO
}

model BloqueoAcceso {
  id               String        @id @default(cuid())
  email            String
  cantidadIntentos Int
  primerIntento    DateTime
  ultimoIntento    DateTime
  estado           EstadoBloqueo @default(PENDIENTE)
  resueltoPorId    String?
  resueltoPorNombre String?
  accionResolucion String?
  resueltoEn       DateTime?
  createdAt        DateTime      @default(now())

  @@index([email, estado])
  @@index([estado, createdAt])
}
