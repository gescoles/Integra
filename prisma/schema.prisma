generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Conexión con pooler (puerto 6543) - usada por la app en runtime
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432) - usada solo para migraciones
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN_CENTRO
  COORDINADOR
  PROFESOR
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

enum SchoolType {
  PRIVADO
  CONCERTADO
  PUBLICO
}

enum Plan {
  BASICO
  PRO
  PREMIUM
}

enum SchoolStatus {
  ACTIVO
  REVISION
  INACTIVO
}

enum Locale {
  CA
  ES
  EN
}

model School {
  id        String       @id @default(cuid())
  name      String
  type      SchoolType   @default(PRIVADO)
  city      String?
  plan      Plan         @default(BASICO)
  status    SchoolStatus @default(ACTIVO)
  userLimit Int          @default(50)
  modules   String[]     @default([])
  logoUrl   String?
  cursoAcademico String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  users     User[]
  tutorias  Tutoria[]
  guardias  Guardia[]
  material  MaterialRequest[]
  alumnos   Alumno[]
  avisos    Aviso[]
  salidas   Salida[]
  practicas PracticaAlumno[]
  historias Historia[]
  incidencias Incidencia[]
  expedientes Expediente[]
  onboardingCarpetas OnboardingCarpeta[]
  plantas EspacioPlanta[]
  coberturas CoberturaGuardia[]
  departamentos Departamento[]
}

// Departamento del centro (p. ej. "Matemàtiques", "Informàtica"). Cada
// profesor puede pertenecer a varios, y cada departamento puede tener
// varios coordinadores. Así, al elegir los departamentos de un profesor,
// se sabe automáticamente quiénes son sus coordinadores.
model Departamento {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  nombre        String
  profesores    User[]   @relation("DepartamentoProfesores")
  coordinadores User[]   @relation("DepartamentoCoordinadores")
  createdAt     DateTime @default(now())
}

// Una "historia" (como en Instagram) que un centro publica; la ven todos
// los usuarios de todos los centros registrados en Docentium, y desaparece
// pasadas 24 horas.
enum TipoHistoria {
  IMAGEN
  VIDEO
}

enum PrioridadIncidencia {
  BAJA
  MEDIA
  ALTA
}

enum EstadoIncidencia {
  ABIERTA
  EN_SEGUIMIENTO
  CERRADA
}

// Un expediente/incidencia disciplinaria de un alumno. Lo puede crear
// cualquier profesor (queda como creador), eligiendo quién es el tutor
// responsable de darle seguimiento; a ese tutor le llega un email y una
// notificación en la app al crearse.
model Incidencia {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  alumnoId String
  alumno   Alumno @relation(fields: [alumnoId], references: [id])

  creadorId String
  creador   User   @relation("IncidenciaCreador", fields: [creadorId], references: [id])
  tutorId   String
  tutor     User   @relation("IncidenciaTutor", fields: [tutorId], references: [id])

  tipoIncidencia String
  prioridad      PrioridadIncidencia @default(MEDIA)
  estado         EstadoIncidencia    @default(ABIERTA)

  fecha   DateTime
  lugar   String?

  descripcion      String
  observaciones    String?
  medidasAplicadas String?

  familiaInformada            Boolean   @default(false)
  familiaInformadaFecha       DateTime?
  familiaInformadaComunicacion String?

  eventos     IncidenciaEvento[]
  expedientes Expediente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum EstadoExpediente {
  BORRADOR
  ENVIADO
}

// El "parte y expulsión" formal. Un alumno (o una misma incidencia, si se
// repite) puede tener VARIOS expedientes a lo largo del tiempo, cada uno
// con su propio número. Se crea como borrador, se puede editar mientras
// esté en borrador, y Coordinación/Dirección/SuperAdmin lo envía al tutor
// cuando está listo (por email, con el PDF adjunto, + notificación).
// Carpetas de OnBoarding para nuevas incorporaciones. Solo Coordinación,
// Dirección o SuperAdmin pueden crearlas, subir archivos o borrar.
model OnboardingCarpeta {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  nombre      String
  creadoPorId String?
  creadoPor   User?    @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)
  archivos    OnboardingArchivo[]
  createdAt   DateTime @default(now())
}

model OnboardingArchivo {
  id          String            @id @default(cuid())
  carpetaId   String
  carpeta     OnboardingCarpeta @relation(fields: [carpetaId], references: [id], onDelete: Cascade)
  nombre      String
  url         String
  tipo        String?
  tamano      Int?
  subidoPorId String?
  subidoPor   User?             @relation(fields: [subidoPorId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
}

// Reserva de espacios: cada centro tiene sus plantas, cada planta sus
// aulas (con su posición y tamaño para dibujarlas en 3D), y cada aula sus
// reservas horarias.
model EspacioPlanta {
  id        String        @id @default(cuid())
  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id])
  numero    Int
  nombre    String
  aulas     EspacioAula[]
  createdAt DateTime      @default(now())

  @@unique([schoolId, numero])
}

model EspacioAula {
  id         String            @id @default(cuid())
  plantaId   String
  planta     EspacioPlanta     @relation(fields: [plantaId], references: [id], onDelete: Cascade)
  nombre     String
  // Posición y tamaño en la cuadrícula del plano (unidades arbitrarias,
  // coherentes con el boceto en cuadrícula), usadas para pintar la caja
  // en 3D y para saber dónde colocarla.
  x          Float
  z          Float
  ancho      Float
  profundo   Float
  alto       Float             @default(2.5)
  color      String            @default("#94A3B8")
  bloqueada       Boolean       @default(false)
  motivoBloqueo   String?
  reservas   EspacioReserva[]
  createdAt  DateTime          @default(now())
}

model EspacioReserva {
  id          String      @id @default(cuid())
  aulaId      String
  aula        EspacioAula @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation("EspacioReservaUsuario", fields: [userId], references: [id])
  creadoPorId String
  creadoPor   User        @relation("EspacioReservaCreador", fields: [creadoPorId], references: [id])
  fecha       DateTime
  horaInicio  String
  horaFin     String
  createdAt   DateTime    @default(now())
}

model Expediente {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])
  alumnoId     String
  alumno       Alumno     @relation(fields: [alumnoId], references: [id])
  incidenciaId String
  incidencia   Incidencia @relation(fields: [incidenciaId], references: [id])

  tutorId     String
  tutor       User @relation("ExpedienteTutor", fields: [tutorId], references: [id])
  creadoPorId String
  creadoPor   User @relation("ExpedienteCreador", fields: [creadoPorId], references: [id])

  numero String
  estado EstadoExpediente @default(BORRADOR)

  fechaInicio           DateTime
  fets                  String
  testimonis            String
  informeTutor          String
  audienciaResumen      String
  valoracionComision    String
  medidasProvisionales  String
  sancionDias           Int
  sancionMotivo         String
  fechaAplicacionInicio DateTime
  fechaAplicacionFin    DateTime
  recursoEstado         String
  direccionNombre       String
  coordinadorNombre     String

  enviadoEn DateTime?

  // Firmas capturadas antes de enviar (imagen en base64), y el email
  // adicional (del alumno) al que también se manda copia.
  firmaDireccion   String?
  firmaTutor       String?
  firmaCoordinador String?
  emailAlumno      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// El historial de actualizaciones que se ve en el detalle de la incidencia:
// se genera solo (creación, cambios de estado, familia informada...), sin
// que nadie tenga que escribirlo a mano.
model IncidenciaEvento {
  id           String     @id @default(cuid())
  incidenciaId String
  incidencia   Incidencia @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)
  tipo         String
  descripcion  String
  autorId      String?
  autor        User?      @relation(fields: [autorId], references: [id])
  createdAt    DateTime   @default(now())
}

model Historia {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id])
  autorId      String
  autor        User         @relation(fields: [autorId], references: [id])
  tipo         TipoHistoria @default(IMAGEN)
  imagenUrl    String
  texto        String?
  ciclo        String?
  createdAt    DateTime     @default(now())
  expiraEn     DateTime
  vistas       HistoriaVista[]
}

// Registro de quién ha visto cada historia (para el "quién ha visto mi
// historia").
model HistoriaVista {
  id         String   @id @default(cuid())
  historiaId String
  historia   Historia @relation(fields: [historiaId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  vistoEn    DateTime @default(now())

  @@unique([historiaId, userId])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  dni          String?    @unique
  role         Role
  status       UserStatus @default(ACTIVO)
  avatarUrl    String?
  locale       Locale     @default(ES)
  lastAccessAt DateTime?
  schoolId     String?
  school       School?    @relation(fields: [schoolId], references: [id])
  createdAt    DateTime   @default(now())
  tutorias     Tutoria[]
  guardias     Guardia[]
  material     MaterialRequest[]
  horario      HorarioBloque[]
  eventos      CalendarEvento[]
  alumnos      Alumno[]
  avisos       Aviso[]
  salidasCreadas     Salida[] @relation("SalidaCreador")
  salidasResponsable Salida[] @relation("SalidaResponsable")
  practicasComoTutor PracticaAlumno[] @relation("PracticaTutorIMES")
  conveniosCerrados  Convenio[] @relation("ConvenioCerradoPor")
  tutoriasSeguimientoCreadas TutoriaSeguimiento[] @relation("TutoriaSeguimientoCreador")
  historias         Historia[]
  historiasVistas   HistoriaVista[]
  incidenciasCreadas     Incidencia[] @relation("IncidenciaCreador")
  incidenciasComoTutor   Incidencia[] @relation("IncidenciaTutor")
  incidenciaEventos      IncidenciaEvento[]
  expedientesComoTutor   Expediente[] @relation("ExpedienteTutor")
  expedientesCreados     Expediente[] @relation("ExpedienteCreador")
  onboardingCarpetasCreadas OnboardingCarpeta[]
  onboardingArchivosSubidos OnboardingArchivo[]
  espacioReservas        EspacioReserva[] @relation("EspacioReservaUsuario")
  espacioReservasCreadas EspacioReserva[] @relation("EspacioReservaCreador")
  coberturasComoAusente     CoberturaGuardia[] @relation("CoberturaAusente")
  coberturasComoSustituto   CoberturaGuardia[] @relation("CoberturaSustituto")
  coberturasCreadas         CoberturaGuardia[] @relation("CoberturaCreador")
  // Un profesor puede pertenecer a varios departamentos, y un coordinador
  // puede coordinar varios departamentos (con varios profesores cada uno).
  departamentos             Departamento[]     @relation("DepartamentoProfesores")
  departamentosCoordinados  Departamento[]     @relation("DepartamentoCoordinadores")
  notificaciones     Notificacion[]
}

enum TutoriaStatus {
  PENDIENTE
  COMPLETADA
}

enum ConQuien {
  FAMILIA
  ALUMNO
  AMBOS
}

enum MedioContacto {
  TELEFONO
  EMAIL
  PRESENCIAL
  APP
}

enum RiesgoNivel {
  BAJO
  MEDIO
  ALTO
}

model Tutoria {
  id                 String        @id @default(cuid())
  schoolId           String
  school             School        @relation(fields: [schoolId], references: [id])
  profesorId         String
  profesor           User          @relation(fields: [profesorId], references: [id])
  alumnoId           String?
  alumno             Alumno?       @relation(fields: [alumnoId], references: [id])
  studentName        String
  cicloModulo        String?
  causa              String        @default("")
  status             TutoriaStatus @default(PENDIENTE)
  sessionDate        DateTime      @default(now())
  conQuien           ConQuien?
  medio              MedioContacto?
  notas              String?
  proximoSeguimiento DateTime?
  createdAt          DateTime      @default(now())
}

model Alumno {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id])
  profesorId String
  profesor   User             @relation(fields: [profesorId], references: [id])
  nombre     String
  curso      String
  edad       Int?
  riesgo     RiesgoNivel      @default(BAJO)
  avatarUrl  String?
  createdAt  DateTime         @default(now())
  contactos  AlumnoContacto[]
  tutorias   Tutoria[]
  practicas  PracticaAlumno[]
  incidencias Incidencia[]
  expedientes Expediente[]
}

model AlumnoContacto {
  id       String  @id @default(cuid())
  alumnoId String
  alumno   Alumno  @relation(fields: [alumnoId], references: [id])
  relacion String
  telefono String?
  email    String?
}

// Nota: PROGRAMADA se mantiene en la base de datos por compatibilidad con
// filas antiguas (para no romper el enum en Postgres), pero la app ya no
// la usa: el vocabulario real ahora es Pendiente / Cubierta / Rechazada.
enum GuardiaStatus {
  PROGRAMADA
  CUBIERTA
  PENDIENTE
  RECHAZADA
}

model ChatbotEntry {
  id           String   @id @default(cuid())
  pregunta     String
  palabrasClave String[] @default([])
  respuesta    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model ChatbotPreguntaSinResponder {
  id        String   @id @default(cuid())
  texto     String
  vista     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Notificacion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String
  tipo      String
  titulo    String
  mensaje   String
  link      String?
  relatedId String?
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, leida])
  @@index([relatedId])
}

enum SalidaEstado {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model Salida {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id])
  curso        String
  tipo         String
  actividad    String
  fecha        DateTime
  horaSalida   String
  horaVuelta   String?
  vueltaDirectaCasa Boolean @default(false)
  responsableId String
  responsable   User        @relation("SalidaResponsable", fields: [responsableId], references: [id])
  profesoresIds String[]    @default([])
  numAlumnos   Int
  costo        Float        @default(0)
  moneda       String       @default("EUR")
  observaciones String?
  calendarioSustituciones String?
  estado       SalidaEstado @default(PENDIENTE)
  creadoPorId  String
  creadoPor    User         @relation("SalidaCreador", fields: [creadoPorId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
}

enum Promocion {
  PRIMERA
  SEGUNDA
}

// Ficha de un alumno en prácticas: sus datos personales/administrativos.
// Cada alumno tiene UNA ficha, y a partir de ahí se le pueden crear uno o
// varios convenios (a lo largo del tiempo, o si repite ciclo, etc.).
model PracticaAlumno {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  alumnoId String @unique
  alumno   Alumno @relation(fields: [alumnoId], references: [id])

  promocion      Promocion @default(PRIMERA)
  cicloFormativo String?
  anyTitulacion  String?

  // Tutor iMES (profesor del centro responsable del alumno en prácticas)
  tutorImesId String?
  tutorImes   User?   @relation("PracticaTutorIMES", fields: [tutorImesId], references: [id])

  dni             String?
  fechaNacimiento DateTime?
  telefono        String?
  direccion       String?
  correoAlumno    String?
  cap             String?
  nuss            String?

  convenios Convenio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Un alumno puede tener varios convenios (por ejemplo, si cambia de empresa,
// o repite curso). Cada convenio es un acuerdo de prácticas concreto.
enum TipoTutoriaSeguimiento {
  INICIAL
  MEDIA
  FINAL
}

model Convenio {
  id               String         @id @default(cuid())
  practicaAlumnoId String
  practicaAlumno   PracticaAlumno @relation(fields: [practicaAlumnoId], references: [id], onDelete: Cascade)

  tipologia       String?
  estadoAcuerdo   String?
  convalida       Boolean   @default(false)
  quienAltaBajaSS String?
  fechaInicio     DateTime?
  fechaFin        DateTime?
  periodo         String?

  empresaCif           String?
  empresaNombre        String?
  tutorEmpresaNombre   String?
  tutorEmpresaTelefono String?
  tutorEmpresaCorreo   String?

  observaciones String?

  // Cierre del convenio: lo puede cerrar el profesor tutor (si ya están las
  // 3 tutorías de seguimiento) o, sin esa condición y siempre editable
  // después, Coordinación/Dirección/SuperAdmin.
  cerrado      Boolean   @default(false)
  notaFinal    String?
  fechaCierre  DateTime?
  cerradoPorId String?
  cerradoPor   User?     @relation("ConvenioCerradoPor", fields: [cerradoPorId], references: [id])

  prorrogas           Prorroga[]
  tutoriasSeguimiento TutoriaSeguimiento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Las 3 tutorías de seguimiento de un convenio en prácticas: inicial, media
// y final. Hay que registrarlas antes de que un profesor pueda cerrar el
// convenio (Coordinación/SuperAdmin pueden saltárselo).
model TutoriaSeguimiento {
  id          String                 @id @default(cuid())
  convenioId  String
  convenio    Convenio               @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  tipo        TipoTutoriaSeguimiento
  fecha       DateTime?
  resumen     String?
  medioContacto String?
  creadoPorId String?
  creadoPor   User?                  @relation("TutoriaSeguimientoCreador", fields: [creadoPorId], references: [id])
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @default(now()) @updatedAt

  @@unique([convenioId, tipo])
}

// Una prórroga alarga (o repite) el período de un convenio ya existente.
// Tiene los mismos campos que un convenio (puede cambiar de empresa,
// tipología, etc.), y un convenio puede tener varias prórrogas seguidas.
model Prorroga {
  id         String   @id @default(cuid())
  convenioId String
  convenio   Convenio @relation(fields: [convenioId], references: [id], onDelete: Cascade)

  tipologia       String?
  estadoAcuerdo   String?
  convalida       Boolean   @default(false)
  quienAltaBajaSS String?
  fechaInicio     DateTime?
  fechaFin        DateTime?
  periodo         String?

  empresaCif           String?
  empresaNombre        String?
  tutorEmpresaNombre   String?
  tutorEmpresaTelefono String?
  tutorEmpresaCorreo   String?

  observaciones String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Guardia {
  id         String        @id @default(cuid())
  schoolId   String
  school     School        @relation(fields: [schoolId], references: [id])
  profesorId String
  profesor   User          @relation(fields: [profesorId], references: [id])
  turno      String
  ubicacion  String?
  grupo      String?
  tarea      String?
  fecha      DateTime
  status     GuardiaStatus @default(PENDIENTE)
  createdAt  DateTime      @default(now())
}

enum MaterialCategoria {
  ELECTRONICA
  COMPONENTES
  HERRAMIENTAS
  OTROS
}

enum MaterialEstado {
  EN_STOCK
  BAJO_STOCK
  AGOTADO
}

model MaterialRequest {
  id            String            @id @default(cuid())
  schoolId      String
  school        School            @relation(fields: [schoolId], references: [id])
  profesorId    String
  profesor      User              @relation(fields: [profesorId], references: [id])
  nombre        String
  curso         String
  asignatura    String
  cantidad      Int               @default(1)
  precioUnidad  Float             @default(0)
  proveedor     String
  enlace        String?
  justificacion String
  categoria     MaterialCategoria @default(OTROS)
  estado        MaterialEstado    @default(EN_STOCK)
  createdAt     DateTime          @default(now())
}

// Horario semanal recurrente del profesor (Lunes=1 ... Viernes=5)
model HorarioBloque {
  id         String   @id @default(cuid())
  profesorId String
  profesor   User     @relation(fields: [profesorId], references: [id])
  diaSemana  Int
  horaInicio String
  horaFin    String
  asignatura String
  grupo      String?
  aula       String?
  color      String   @default("#2F6FED")
  // Si está marcado, esta franja no es una clase: es una hora de guardia
  // del profesor, y se usa para saber quién está disponible al buscar
  // quién puede cubrir una ausencia.
  esGuardia  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Eventos libres del calendario personal de cada usuario, con fecha concreta

// Cuando un profesor falta, Coordinación/Dirección/SuperAdmin buscan quién
// está de guardia en esa franja concreta y le piden que cubra la clase.
// Queda constancia de quién cubrió a quién y cuándo.
enum EstadoCobertura {
  PENDIENTE
  ASIGNADA
  RECHAZADA
}

model CoberturaGuardia {
  id                  String          @id @default(cuid())
  schoolId            String
  school              School          @relation(fields: [schoolId], references: [id])
  profesorAusenteId   String
  profesorAusente     User            @relation("CoberturaAusente", fields: [profesorAusenteId], references: [id])
  profesorSustitutoId String?
  profesorSustituto   User?           @relation("CoberturaSustituto", fields: [profesorSustitutoId], references: [id])
  fecha               DateTime
  horaInicio          String
  horaFin             String
  asignatura          String?
  grupo               String?
  ubicacion           String?
  // Lo que el profesor ausente ha dejado explicado para sus alumnos: qué
  // deben hacer mientras no está. Solo se rellena cuando es el propio
  // profesor quien avisa (no cuando dirección crea la guardia a mano).
  trabajoAlumnos      String?
  // Motivo de la ausencia, cuando es el profesor quien avisa.
  motivo              String?
  // Motivo que da dirección al rechazar una solicitud, para que el
  // profesor sepa por qué sin tener que preguntar por otro lado.
  motivoRechazo       String?
  estado              EstadoCobertura @default(ASIGNADA)
  creadoPorId         String
  creadoPor           User            @relation("CoberturaCreador", fields: [creadoPorId], references: [id])
  createdAt           DateTime        @default(now())
}

model CalendarEvento {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String
  fecha      DateTime
  horaInicio String
  horaFin    String
  color      String   @default("#2F6FED")
  createdAt  DateTime @default(now())
}

enum AvisoCategoria {
  GENERAL
  ACADEMICO
  CONVIVENCIA
}

// Avisos del centro, visibles para todo el personal del mismo centro
model Aviso {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id])
  autorId   String
  autor     User           @relation(fields: [autorId], references: [id])
  titulo    String
  cuerpo    String
  categoria AvisoCategoria @default(GENERAL)
  createdAt DateTime       @default(now())
}
